# Copy to .env.local and fill in values. Never commit .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ANTHROPIC_KEY=

# Supabase Auth redirect URLs are configured in the Supabase dashboard (not here):
# Authentication → URL Configuration → Redirect URLs must include:
#   http://localhost:5173/app
#   http://localhost:5173/reset-password
#   https://familypause.com/app
#   https://familypause.com/reset-password
# The client uses window.location.origin for redirectTo at runtime.

# Stripe Payment Links — used as checkout fallback (and for monthly until edge price is set)
VITE_STRIPE_FAMILY_ANNUAL=https://buy.stripe.com/test_3cI3cwb7of0m31RcPgcjS00
VITE_STRIPE_FAMILY_MONTHLY=https://buy.stripe.com/test_eVq3cwdfw6tQ31R16ycjS02
VITE_STRIPE_FAMILY_PRO=
VITE_STRIPE_CARD_DIGITAL=https://buy.stripe.com/test_6oUbJ27VcdWi0TJ02ucjS01
# Optional — onboarding digital upsell; defaults to VITE_STRIPE_CARD_DIGITAL if unset
VITE_STRIPE_DIGITAL_12=

# Stripe publishable key (browser-safe; also set in Vercel)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51TwBODKM4OegYQ8pBQhhsC4JZ1DPs9J35fek0IeHxKoiIayGJzDe0diS2VKWk6YmbUko3Hh67gaXScDEZG9UeXFn00DIJ2fMZt

# Stripe secrets — set in Supabase only (NOT in Vercel):
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   supabase secrets set STRIPE_PRICE_FAMILY=price_...   # $59/yr subscription
#   supabase secrets set STRIPE_PRICE_PRO=price_...      # $99/yr subscription
#   supabase secrets set STRIPE_PRICE_DIGITAL=price_...  # $9.97 one-time

# After creating Payment Links in Stripe, set confirmation redirects to:
#   Success: https://familypause.com/subscribe/success
#   Cancel:  https://familypause.com/subscribe/cancel

# Google Calendar OAuth — Supabase secrets only (NOT in Vercel):
#   supabase secrets set GOOGLE_CLIENT_ID=...
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#   supabase secrets set GOOGLE_OAUTH_STATE_SECRET=...   # random 32+ chars
#   supabase secrets set GOOGLE_APP_ORIGIN=https://familypause.com
